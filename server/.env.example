# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Placeholder - do not commit real secrets)
MONGODB_URI=mongodb://localhost:27017/blackbox_dev

# Authentication Secrets (Generate secure 256-bit random keys for production)
JWT_ACCESS_SECRET=your_jwt_access_secret_placeholder_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_placeholder_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Initial Administrator Provisioning Bootstrap
INITIAL_ADMIN_EMAIL=admin@blackbox.local
INITIAL_ADMIN_SETUP_SECRET=dev_admin_setup_secret_placeholder

# Google Identity Services / OpenID Connect (Optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# AI Investigator (Google Gemini API - Optional, deterministic fallback active if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS & Client Origin
CORS_ORIGIN=http://localhost:5173

# File Upload Directory
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
